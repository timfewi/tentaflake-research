{
  "version": 1,
  "checks": [
    {
      "name": "source-inputs",
      "argv": [
        "bash",
        "tests/source-inputs.sh"
      ],
      "requires": [
        "bash",
        "nix",
        "mktemp",
        "timeout",
        "mkfifo"
      ],
      "timeout_seconds": 120,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "client-package-evaluation",
      "argv": [
        "nix", "eval", "--raw", "--no-write-lock-file",
        "path:.#checks.x86_64-linux.client-packaging.drvPath"
      ],
      "requires": ["nix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "source-fast",
      "argv": [
        "bash",
        "scripts/check",
        "fast"
      ],
      "requires": [
        "bash",
        "cargo",
        "rustfmt",
        "clippy-driver",
        "nixfmt",
        "shellcheck",
        "deadnix",
        "statix"
      ],
      "timeout_seconds": 1800,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "packages-and-config",
      "argv": [
        "nix",
        "build",
        "--no-link",
        ".#research-service",
        ".#research-client",
        ".#research-egress",
        ".#checks.x86_64-linux.module",
        ".#checks.x86_64-linux.network-boundary",
        ".#checks.x86_64-linux.resource-boundary"
      ],
      "requires": [
        "nix"
      ],
      "timeout_seconds": 1800,
      "profiles": [
        "full"
      ]
    }
  ]
}
